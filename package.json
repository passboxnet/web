{
  "name": "passbox-web",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @passbox/web build",
    "dev": "pnpm --filter @passbox/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @passbox/web test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "pnpm --filter @passbox/e2e e2e",
    "release": "node scripts/release-web.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "5.9.3"
  }
}
